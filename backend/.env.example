# KitchenOS Environment Variables
PORT=8001

# Google Gemini API Key for Zero-Waste Chef, Knowledge Retrieval, and Voice Parsing
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key for Hands-Free Kitchen Voice Responses
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Push notifications topic (ntfy.sh)
NTFY_TOPIC=kitchenos-alerts
